# -----------------------------------------------------------------------------
# Docker 构建上下文裁剪
# 通过排除依赖与缓存产物降低镜像体积，提升构建效率与安全性。
# -----------------------------------------------------------------------------

# 前端依赖与构建产物
frontend/node_modules
frontend/dist

# 后端虚拟环境与缓存
backend/__pycache__
backend/.venv
backend/*.pyc

# 版本控制与本地覆盖文件
.git
.gitignore
docker-compose.override.yml
