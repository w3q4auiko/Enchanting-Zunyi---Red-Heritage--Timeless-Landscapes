# -----------------------------------------------------------------------------
# 环境样例配置
# 本文件描述旅游信息系统部署所需的关键变量与业务含义。
# 生产环境请复制为 .env.production 并替换敏感项。
# -----------------------------------------------------------------------------

# 运行环境与调试策略：控制日志与安全基线。
APP_ENV=local
FLASK_DEBUG=False

# 安全域与跨域边界：用于令牌签名与前后端访问控制。
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SITE_URL=

# 图片上传：仅允许 JPG、PNG、WebP，容器部署时使用持久化目录。
MAX_CONTENT_LENGTH=8388608
MAX_IMAGE_UPLOAD_BYTES=5242880
UPLOAD_ROOT=backend/uploads

# 登录安全：短期访问令牌 + 可撤销、自动轮换的 HttpOnly 刷新令牌。
JWT_ACCESS_MINUTES=30
JWT_ISSUER=zunyi-tourism-api
JWT_AUDIENCE=zunyi-tourism-web
AUTH_REFRESH_DAYS=30
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_REGISTER_MAX_PER_HOUR=5
AUTH_COOKIE_NAME=zunyi_refresh_token
AUTH_COOKIE_SAMESITE=Lax
# Docker Compose / Nginx 部署保持 true；后端直接暴露时必须改为 false。
TRUST_PROXY=true

# 数据库连接与初始化：应用必须使用最小权限专用账号，禁止使用 root。
DB_HOST=db
DB_PORT=3306
DB_NAME=zunyi_tourism
DB_USER=zunyi_db
DB_PASSWORD=smLcSJYyDQn%c!S4Q8-yqk-p
MYSQL_ROOT_PASSWORD=smLcSJYyDQn%c!S4Q8-yqk-p
DB_POOL_SIZE=20

# Gunicorn 生产服务参数：用于并发与超时治理。
GUNICORN_BIND=0.0.0.0:5000
GUNICORN_WORKER_CLASS=gevent
# GUNICORN_WORKERS=9
# GUNICORN_TIMEOUT=60
# GUNICORN_GRACEFUL_TIMEOUT=30
# GUNICORN_KEEPALIVE=5

# 对外端口映射：定义前端与运维工具访问入口。
FRONTEND_PORT=80
PMA_PORT=8080
