# -----------------------------------------------------------------------------
# Git 忽略清单
# 用于排除构建产物、本地环境与临时文件，保持代码仓库可复现与整洁。
# -----------------------------------------------------------------------------

# 通用临时文件
.DS_Store
Thumbs.db
*.log

# 环境变量文件
.env
.env.*
!.env.example

# Python 运行产物
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.python-version
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Node / Vite 构建产物
node_modules/
dist/
build/
.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE / Editor 配置
.vscode/
.idea/

# 项目约定的本地目录
manualdata/
docs/
frontend/public/img/
backend/uploads/*
!backend/uploads/.gitkeep
datebase